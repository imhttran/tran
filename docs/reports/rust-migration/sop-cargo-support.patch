@@ -0,0 +1,188 @@
+package cli
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/imhttran/agentic-sop/internal/config"
+	"github.com/imhttran/agentic-sop/internal/quality"
+	"github.com/imhttran/agentic-sop/internal/taskfile"
+)
+
+func cargoOnConfig() config.Config {
+	cfg := config.Config{}
+	cfg.Validation.AcceptanceChecks.Cargo = true
+	return cfg
+}
+
+func cargoTestGate() quality.Result { return quality.Result{Decision: quality.Pass} }
+
+func TestAuthorizeCargoAcceptanceCommand(t *testing.T) {
+	root := t.TempDir()
+	on := cargoOnConfig()
+	off := config.Config{}
+
+	for _, cmd := range []string{
+		"cargo build --manifest-path rust/Cargo.toml",
+		"cargo test --locked",
+		"cargo clippy --all-targets",
+		"cargo fmt --check",
+	} {
+		if _, err := authorizeAcceptanceCommand(cmd, acceptanceCheckPolicy(on), root); err != nil {
+			t.Errorf("opted-in %q should authorize, got %v", cmd, err)
+		}
+	}
+	if !on.CargoAcceptanceChecksEnabled() {
+		t.Error("opt-in accessor should be true")
+	}
+	if off.CargoAcceptanceChecksEnabled() {
+		t.Error("opt-in must default to false")
+	}
+	if _, err := authorizeAcceptanceCommand("cargo test", acceptanceCheckPolicy(off), root); err == nil {
+		t.Error("cargo test must remain unauthorized when not opted in")
+	}
+	for _, cmd := range []string{
+		"cargo fmt", "cargo run", "cargo install", "cargo publish", "cargo add serde", "cargo fix",
+		"cargo build --config net.offline=true", "cargo build -Z unstable-options",
+		"cargo build --target-dir /tmp/x", "cargo build --target ./evil.json",
+		"cargo build --release", "cargo test --", "cargo clippy -- -D allow",
+		"cd rust && cargo test", "cargo test | tee out", "cargo test $(pwd)",
+		`cargo test --manifest-path " escape/Cargo.toml"`, // surrounding whitespace
+	} {
+		if _, err := authorizeAcceptanceCommand(cmd, acceptanceCheckPolicy(on), root); err == nil {
+			t.Errorf("opted-in %q must NOT authorize", cmd)
+		}
+	}
+}
+
+// TestAuthorizeCargoManifestPathContainment is portable: it exercises only the
+// path rules that need no symlink support (absolute, parent traversal, empty,
+// missing value). Symlink behaviour lives in its own test below.
+func TestAuthorizeCargoManifestPathContainment(t *testing.T) {
+	root := t.TempDir()
+	pol := acceptanceCheckPolicy(cargoOnConfig())
+
+	allowed := []string{
+		"cargo test --manifest-path Cargo.toml",
+		"cargo test --manifest-path=rust/Cargo.toml",
+		"cargo build --manifest-path rust/Cargo.toml",
+		"cargo clippy --manifest-path=rust/Cargo.toml",
+		"cargo fmt --manifest-path rust/Cargo.toml --check",
+		"cargo fmt --manifest-path=rust/Cargo.toml --check",
+	}
+	for _, cmd := range allowed {
+		if _, err := authorizeAcceptanceCommand(cmd, pol, root); err != nil {
+			t.Errorf("in-repo %q should authorize, got %v", cmd, err)
+		}
+	}
+
+	rejected := []string{
+		"cargo test --manifest-path /etc/Cargo.toml",      // absolute (space form)
+		"cargo test --manifest-path=/etc/Cargo.toml",      // absolute (= form)
+		"cargo test --manifest-path ../Cargo.toml",        // parent traversal
+		"cargo test --manifest-path=../../etc/Cargo.toml", // parent traversal (=)
+		"cargo test --manifest-path rust/../../Cargo.toml",
+		"cargo test --manifest-path=", // empty value
+		"cargo test --manifest-path",  // missing value
+	}
+	for _, cmd := range rejected {
+		if _, err := authorizeAcceptanceCommand(cmd, pol, root); err == nil {
+			t.Errorf("%q must be rejected (path containment)", cmd)
+		}
+	}
+}
+
+// TestContainedRepoPathRejectsWhitespace pins that the value validated is the exact
+// value that runs: surrounding whitespace is refused, never trimmed.
+func TestContainedRepoPathRejectsWhitespace(t *testing.T) {
+	root := t.TempDir()
+	for _, bad := range []string{" escape/x", "escape/x ", "\tescape/x", "  "} {
+		if err := containedRepoPath(root, bad); err == nil {
+			t.Errorf("containedRepoPath(%q) = nil, want an error", bad)
+		}
+	}
+	if err := containedRepoPath(root, "rust/Cargo.toml"); err != nil {
+		t.Errorf("in-repo path errored: %v", err)
+	}
+}
+
+// TestCargoManifestPathSymlinkEscapeRejected covers the symlink escape, including a
+// whitespace-prefixed one. Symlink creation is unavailable on some platforms (for
+// example Windows without Developer Mode); that is handled explicitly by skipping.
+func TestCargoManifestPathSymlinkEscapeRejected(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(root, "escape")); err != nil {
+		t.Skipf("symlink support unavailable on this platform: %v", err)
+	}
+	pol := acceptanceCheckPolicy(cargoOnConfig())
+
+	// The direct check does not depend on command tokenization.
+	if err := containedRepoPath(root, " escape/Cargo.toml"); err == nil {
+		t.Error("a whitespace-prefixed escape path must be rejected")
+	}
+
+	for _, cmd := range []string{
+		"cargo test --manifest-path escape/Cargo.toml",    // symlink escape
+		`cargo test --manifest-path " escape/Cargo.toml"`, // whitespace-prefixed symlink escape
+		`cargo test --manifest-path=" escape/Cargo.toml"`, // whitespace-prefixed (= form)
+	} {
+		if _, err := authorizeAcceptanceCommand(cmd, pol, root); err == nil {
+			t.Errorf("%q must be rejected (symlink/whitespace escape)", cmd)
+		}
+	}
+}
+
+// TestRejectedCargoCommandNeverExecutes puts a fake `cargo` on PATH that writes a
+// marker when invoked, then proves a rejected command never runs it while an
+// allowed command does. The fake is a POSIX shell script, so the test is skipped
+// explicitly on platforms without POSIX execution semantics (Windows).
+func TestRejectedCargoCommandNeverExecutes(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("the fake `#!/bin/sh` cargo is not executable on Windows; this check is POSIX-only")
+	}
+	dir := t.TempDir()
+	marker := filepath.Join(dir, "ran")
+	bin := filepath.Join(dir, "bin")
+	if err := os.MkdirAll(bin, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	script := "#!/bin/sh\ntouch '" + marker + "'\nexit 0\n"
+	if err := os.WriteFile(filepath.Join(bin, "cargo"), []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	cfg := cargoOnConfig()
+
+	// Control: an allowed command executes (marker appears).
+	if err := os.Remove(marker); err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	res := deriveOutcome(cfg, &taskfile.Spec{ID: "OK", AcceptanceChecks: []string{"cargo test"}}, dir, cargoTestGate())
+	if res == nil {
+		t.Fatal("nil outcome")
+	}
+	if _, err := os.Stat(marker); err != nil {
+		t.Fatalf("allowed cargo check did not execute (no marker): %v; outcome=%+v", err, res)
+	}
+
+	// Rejected forms must NOT execute.
+	for _, cmd := range []string{
+		"cargo run",
+		"cargo build --config x=y",
+		"cargo build --target ./evil.json",
+		"cargo build --release",
+		"cargo test --manifest-path ../Cargo.toml",
+		`cargo test --manifest-path " escape/Cargo.toml"`,
+	} {
+		if err := os.Remove(marker); err != nil && !os.IsNotExist(err) {
+			t.Fatal(err)
+		}
+		deriveOutcome(cfg, &taskfile.Spec{ID: "X", AcceptanceChecks: []string{cmd}}, dir, cargoTestGate())
+		if _, err := os.Stat(marker); err == nil {
+			t.Errorf("rejected %q executed the command (marker present)", cmd)
+		}
+	}
+}
diff --git a/internal/cli/cargo_acceptance_flow_test.go b/internal/cli/cargo_acceptance_flow_test.go
new file mode 100644
index 0000000..565f4bc
--- /dev/null
+++ b/internal/cli/cargo_acceptance_flow_test.go
@@ -0,0 +1,145 @@
+//go:build acceptance
+
+// Native Cargo acceptance-check flow through the production outcome seam, using a
+// real cargo against a crate nested in a repository subdirectory. Proves: each
+// supported command shape (build/test/clippy/fmt --check) yields VERIFIED, a
+// failing test yields PARTIAL, a missing check stays unverified, rejected
+// commands keep the boundary/HOLD behavior, the opt-in defaults off, and Go
+// checks are unchanged. Skips (never fails) when cargo is unavailable.
+
+package cli
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/imhttran/agentic-sop/internal/config"
+	"github.com/imhttran/agentic-sop/internal/outcome"
+	"github.com/imhttran/agentic-sop/internal/taskfile"
+)
+
+func accOpCargoRoot(t *testing.T, testBody string) string {
+	t.Helper()
+	root := t.TempDir()
+	write := func(rel, content string) {
+		p := filepath.Join(root, rel)
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("rust/Cargo.toml", "[package]\nname = \"acccrate\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")
+	write("rust/src/lib.rs", "pub fn ok() -> bool {\n    true\n}\n")
+	write("rust/tests/it.rs", testBody)
+	return root
+}
+
+func accOpCargoSpec(checks ...string) *taskfile.Spec {
+	if checks == nil {
+		return &taskfile.Spec{ID: "CARGO", Title: "cargo", AcceptanceCriteria: []string{"crate tests pass"}}
+	}
+	return &taskfile.Spec{
+		ID:                 "CARGO",
+		Title:              "cargo",
+		AcceptanceCriteria: []string{"crate tests pass"},
+		AcceptanceChecks:   checks,
+	}
+}
+
+func accOpHasCriterion(res *outcomeArtifact, id string, met bool) bool {
+	for _, c := range res.Criteria {
+		if c.ID == id && c.Met == met {
+			return true
+		}
+	}
+	return false
+}
+
+func TestCargoNestedCrateCommandsVerify(t *testing.T) {
+	if _, err := exec.LookPath("cargo"); err != nil {
+		t.Skip("cargo not on PATH")
+	}
+	cfg := cargoOnConfig()
+	pass := accOpCargoRoot(t, "#[test]\nfn it_works() {\n    assert!(acccrate::ok());\n}\n")
+
+	commands := []string{
+		"cargo build --manifest-path rust/Cargo.toml",
+		"cargo test --manifest-path rust/Cargo.toml",
+		"cargo test --manifest-path=rust/Cargo.toml",
+		"cargo clippy --manifest-path=rust/Cargo.toml",
+		"cargo fmt --manifest-path rust/Cargo.toml --check",
+		"cargo fmt --manifest-path=rust/Cargo.toml --check",
+	}
+	for _, cmd := range commands {
+		res := deriveOutcome(cfg, accOpCargoSpec(cmd), pass, accOpPassGate())
+		if res == nil || res.Status != outcome.Verified {
+			t.Errorf("%q: outcome = %+v, want VERIFIED", cmd, res)
+			continue
+		}
+		if c := accOpCheck(t, res, cmd); !c.Met || c.ExitCode != 0 {
+			t.Errorf("%q: criterion lacks met+exit0 evidence: %+v", cmd, c)
+		}
+	}
+}
+
+func TestCargoAcceptanceCheckOutcomeFlow(t *testing.T) {
+	if _, err := exec.LookPath("cargo"); err != nil {
+		t.Skip("cargo not on PATH; skipping native cargo acceptance-check flow")
+	}
+	cfg := cargoOnConfig()
+	passing := accOpCargoRoot(t, "#[test]\nfn it_works() {\n    assert!(acccrate::ok());\n}\n")
+
+	// Failing check -> PARTIAL, check unmet.
+	failing := accOpCargoRoot(t, "#[test]\nfn it_fails() {\n    assert!(!acccrate::ok());\n}\n")
+	res := deriveOutcome(cfg, accOpCargoSpec("cargo test --manifest-path rust/Cargo.toml"), failing, accOpPassGate())
+	if res == nil || res.Status != outcome.Partial {
+		t.Fatalf("failing cargo check: status = %+v, want PARTIAL", res)
+	}
+	if c := accOpCheck(t, res, "cargo test --manifest-path rust/Cargo.toml"); c.Met {
+		t.Fatalf("failing check marked met: %+v", c)
+	}
+
+	// No check -> unverified (PARTIAL, objective-acceptance unmet).
+	res = deriveOutcome(cfg, accOpCargoSpec(), passing, accOpPassGate())
+	if res == nil || res.Status != outcome.Partial || !accOpHasCriterion(res, "objective-acceptance", false) {
+		t.Fatalf("no check: outcome = %+v, want PARTIAL with unmet objective-acceptance", res)
+	}
+
+	// Rejected commands -> HOLD boundary, never run.
+	for _, cmd := range []string{
+		"cargo run",
+		"cargo install",
+		"cargo fmt",
+		"cargo test --manifest-path ../Cargo.toml",
+		"cargo test --manifest-path /etc/Cargo.toml",
+		"cd rust && cargo test",
+	} {
+		res = deriveOutcome(cfg, accOpCargoSpec(cmd), passing, accOpPassGate())
+		if res == nil || res.Status != outcome.Hold {
+			t.Fatalf("rejected %q: status = %+v, want HOLD", cmd, res)
+		}
+		if c := accOpCheck(t, res, cmd); !c.Boundary || c.Met {
+			t.Fatalf("rejected %q: Boundary=%v Met=%v, want an unmet boundary", cmd, c.Boundary, c.Met)
+		}
+	}
+
+	// Default-off: an otherwise-allowed cargo check is a boundary too.
+	res = deriveOutcome(config.Config{}, accOpCargoSpec("cargo test --manifest-path rust/Cargo.toml"), passing, accOpPassGate())
+	if res == nil || res.Status != outcome.Hold {
+		t.Fatalf("un-opted-in cargo check: status = %+v, want HOLD", res)
+	}
+
+	// Go checks unchanged.
+	goDir := accOpModule(t, map[string]string{
+		"pass/pass.go":      "package pass\n\n// V is a value.\nconst V = 1\n",
+		"pass/pass_test.go": "package pass\n\nimport \"testing\"\n\nfunc TestPass(t *testing.T) {}\n",
+	})
+	res = deriveOutcome(config.Config{}, accOpCargoSpec("go test ./pass/..."), goDir, accOpPassGate())
+	if res == nil || res.Status != outcome.Verified {
+		t.Fatalf("go check must stay unaffected by the cargo opt-in: %+v", res)
+	}
+}
