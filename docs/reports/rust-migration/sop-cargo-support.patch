+// cargoFlagPolicy is the default-deny argument policy for one cargo subcommand:
+// only the listed flags are accepted, each at most once. A cargo acceptance check
+// naming any other flag or argument is refused. This is a default-deny allow-list,
+// not a denylist, so an unknown or future cargo flag - for example --target, which
+// also accepts a custom target-spec path - can never reach execution.
+type cargoFlagPolicy struct {
+	// flags are the allowed flags, written with their leading dashes.
+	flags map[string]bool
+	// requireCheck (fmt only) requires --check to be present.
+	requireCheck bool
+}
+
+var cargoPolicies = map[string]cargoFlagPolicy{
+	"build":  {flags: map[string]bool{"--locked": true, "--all-targets": true, "--manifest-path": true}},
+	"test":   {flags: map[string]bool{"--locked": true, "--all-targets": true, "--manifest-path": true}},
+	"clippy": {flags: map[string]bool{"--locked": true, "--all-targets": true, "--manifest-path": true}},
+	"fmt": {
+		flags:        map[string]bool{"--check": true, "--all": true, "--manifest-path": true},
+		requireCheck: true,
+	},
+}
+
+// isAllowedCargo reports whether argv is one of the scoped cargo verification
+// shapes under the default-deny argument policy: `cargo build|test|clippy ...`
+// (optionally ending in the exact suffix `-- -D warnings` for clippy) or
+// `cargo fmt ... --check`. Only the flags in cargoPolicies are accepted, each at
+// most once, so unknown flags, --target and other path/toolchain selectors,
+// positional arguments (including a `+toolchain` override), and anything after
+// `--` other than clippy's exact suffix are refused. Plain `cargo fmt` (which
+// rewrites files) is refused because --check is required.
+func isAllowedCargo(argv []string) bool {
+	if len(argv) < 2 || filepath.Base(argv[0]) != "cargo" {
+		return false
+	}
+	sub := argv[1]
+	pol, ok := cargoPolicies[sub]
+	if !ok {
+		return false
+	}
+	rest := argv[2:]
+
+	// clippy may end with the exact suffix `-- -D warnings`; any other use of `--`
+	// is refused by cargoFlagsAllowed.
+	if sub == "clippy" {
+		if n := len(rest); n >= 3 && rest[n-3] == "--" && rest[n-2] == "-D" && rest[n-1] == "warnings" {
+			rest = rest[:n-3]
+		}
+	}
+	return cargoFlagsAllowed(rest, pol)
+}
+
+// cargoFlagsAllowed checks a subcommand's arguments against its policy. Every
+// argument must be an allowed flag, at most once; --manifest-path takes exactly one
+// non-empty value, either separated ("--manifest-path PATH") or attached
+// ("--manifest-path=PATH"); a leading "-" value, a missing value, and a value on a
+// flag that takes none are all refused, as are `--` and positional arguments.
+func cargoFlagsAllowed(args []string, pol cargoFlagPolicy) bool {
+	seen := make(map[string]bool, len(args))
+	hasCheck := false
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		if a == "--" || !strings.HasPrefix(a, "-") {
+			return false
+		}
+		name, value, hasValue := a, "", false
+		if j := strings.IndexByte(a, '='); j >= 0 {
+			name, value, hasValue = a[:j], a[j+1:], true
+		}
+		if !pol.flags[name] || seen[name] {
+			return false
+		}
+		seen[name] = true
+		if name == "--manifest-path" {
+			if !hasValue {
+				if i+1 >= len(args) {
+					return false
+				}
+				i++
+				value = args[i]
+			}
+			// Validate the exact value that runs: reject empty, surrounding
+			// whitespace (never trimmed), and a flag-looking value.
+			if value == "" || value != strings.TrimSpace(value) || strings.HasPrefix(value, "-") {
+				return false
+			}
+			continue
+		}
+		if hasValue {
+			return false // this flag takes no value
+		}
+		if name == "--check" {
+			hasCheck = true
+		}
+	}
+	return !pol.requireCheck || hasCheck
+}
