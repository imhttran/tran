+			i++
+		case strings.HasPrefix(a, "--manifest-path="):
+			value = strings.TrimPrefix(a, "--manifest-path=")
+		default:
+			continue
+		}
+		if err := containedRepoPath(root, value); err != nil {
+			return fmt.Errorf("acceptance check %q: --manifest-path %q %s", strings.Join(argv, " "), value, err)
+		}
+	}
+	return nil
+}
+
+// containedRepoPath reports whether value names a path inside root. It validates the
+// exact argument execution receives - never a trimmed copy - and refuses an empty
+// value, surrounding whitespace, an absolute path, any ".." component, and a path
+// whose symlink-resolved form escapes root.
+func containedRepoPath(root, value string) error {
+	if value == "" {
+		return errors.New("is empty")
+	}
+	// Reject surrounding whitespace rather than trimming it, so the value checked is
+	// the value that runs (a trimmed check could diverge from the executed argument).
+	if value != strings.TrimSpace(value) {
+		return errors.New("has surrounding whitespace")
+	}
+	if filepath.IsAbs(value) {
+		return errors.New("is absolute")
+	}
+	for _, part := range strings.Split(filepath.ToSlash(value), "/") {
+		if part == ".." {
+			return errors.New("traverses to a parent directory")
+		}
+	}
+	rootReal := root
+	if r, err := filepath.EvalSymlinks(root); err == nil {
+		rootReal = r
+	}
+	// A symlink in any existing ancestor must not let the path escape root; the
+	// final component may legitimately not exist yet, so resolve the nearest
+	// existing ancestor and confine that.
+	for dir := filepath.Join(root, value); ; {
+		if real, err := filepath.EvalSymlinks(dir); err == nil {
+			rel, rerr := filepath.Rel(rootReal, real)
+			if rerr != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				return errors.New("resolves outside the repository")
+			}
+			break
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	return nil
+}
