# Copy this file to `.env` and load it into your shell. Go does not read `.env`
# files on its own, so the values must be exported:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Every value below matches the built-in default, so an empty `.env` (or none at
# all) works with the bundled docker-compose.yml and a local Ollama.

# Ollama server URL. Used by all three commands.
OLLAMA_URL=http://localhost:11434

# Embedding model. Used by all three commands.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Embedding dimension. MUST equal the dimension of the documents.embedding
# column (vector(768) from migrations/001_init.sql, the dimension
# nomic-embed-text produces). A mismatch fails fast at startup via the schema
# guard in internal/ingestion. To use a non-768 model, apply the procedure in
# docs/operations/embedding-dimension.md, re-ingest, and set this to match.
# Used by all three commands. Default 768 needs no migration.
EMBED_DIM=768

# Chat model. Used by cmd/rag, and by cmd/eval when a judge or reranker is on.
OLLAMA_CHAT_MODEL=qwen3.8:27b-mlx

# Embedder/generator provider selector. "ollama" is the only registered provider.
# Used by all three commands. See internal/provider.
EMBED_PROVIDER=ollama

# Generator provider selector. "ollama" is the only registered provider.
GEN_PROVIDER=ollama

# PostgreSQL + pgvector connection string. Used by all three commands.
DATABASE_URL=postgres://rag:rag@127.0.0.1:5434/rag?sslmode=disable

# Words per chunk and the overlap between consecutive chunks. Used by
# cmd/ingest; re-run ingest after changing either.
CHUNK_SIZE=50
CHUNK_OVERLAP=20

# Bounded concurrency and retry count for embedding during ingestion. Used by
# cmd/ingest.
EMBED_WORKERS=4
EMBED_RETRIES=3

# Candidates retrieved from each strategy (vector + keyword). Used by cmd/rag
# and cmd/eval.
TOP_K=4

# Fused candidates kept before expanding sections. Used by cmd/rag and cmd/eval.
FINAL_K=3

# Section chunks sent as context after expansion. Used by cmd/rag and cmd/eval.
EXPAND_LIMIT=20

# Lowest cosine similarity a chunk may have to be used as context. Used by
# cmd/rag and cmd/eval.
MIN_SIMILARITY=0.6

# Byte-estimate cap on the context cmd/rag sends to the model. 0 (the default)
# disables the builder and keeps the chunk-count behaviour. Used by cmd/rag.
CONTEXT_BUDGET=0

# Maximum size in bytes of the user question cmd/rag accepts. 0 (the default)
# disables the check, preserving the current behavior. An oversized question
# fails fast, before any model call, with an error naming this variable.
MAX_QUESTION_BYTES=0

# Maximum size in bytes of the retrieved context cmd/rag sends to the model. 0
# (the default) disables the check, preserving the current behavior. An
# oversized context fails fast, before any model call, with an error naming this
# variable.
MAX_INPUT_BYTES=0

# Corpus language (BCP-47, e.g. "en", "de", "fr") used to pick the PostgreSQL
# full-text search configuration for ingestion and keyword retrieval. Empty (the
# default) keeps the baseline 'english' configuration, so an unset value changes
# nothing. Used by cmd/ingest and cmd/rag.
CORPUS_LANGUAGE=

# Timeout for each network call. Used by all three commands.
REQUEST_TIMEOUT=5m

# Rerank cmd/eval candidates lexically. Off by default.
EVAL_LEXICAL_RERANK=false

# Also rerank cmd/eval candidates with the chat model. Off by default: slower and
# needs OLLAMA_CHAT_MODEL.
EVAL_LLM_RERANK=false

# Evaluation dataset cmd/eval scores. Unset or empty (the default) loads
# evals/retrieval.json exactly as before; set it to a path such as
# evals/retrieval-vi-en.json to score the bilingual dataset without editing
# code. A missing, unreadable, or malformed file fails fast with an error naming
# the path. Used by cmd/eval.
# EVAL_DATASET=evals/retrieval-vi-en.json

# Bound how long the LLM reranker waits for the chat model before falling back to
# the fused order. 0 (the default) disables the guard, preserving the current
# behavior; a duration such as 10s bounds the reranker call only. REQUEST_TIMEOUT
# still bounds the whole request. Used by cmd/rag and cmd/eval.
RERANK_TIMEOUT=0s

# Ask the chat model whether the retrieved evidence can answer each question.
# Off by default: it adds one chat-model call per case.
EVAL_ANSWERABILITY_GATE=false

# Ask the chat model which of a case's expected_facts the expanded evidence
# supports. Off by default: it adds one chat-model call per case with facts.
EVAL_FACT_JUDGE=false

# Check answerability with the chat model before cmd/rag answers. On by default:
# it adds one chat-model call per query.
RAG_ANSWERABILITY_GATE=true

# Validate and repair the model's [source - section] citations in cmd/rag. Off by
# default; when off the answer path is unchanged.
RAG_CITATION_VALIDATION=false

# Output format for cmd/rag telemetry: "human" (default) keeps the existing stage
# output; "json" emits one structured record per run with a run ID.
OBSERVABILITY_FORMAT=human

# Rerank cmd/rag candidates with the chat model before expanding sections. Off
# by default: it adds one chat-model call per query. A malformed or slow reranker
# degrades to the fused order and the request still answers.
RAG_LLM_RERANK=false

# Rewrite each question into a search query with the chat model before
# retrieval. On by default: it improves recall, at the cost of one chat-model
# call per query.
QUERY_REWRITE=true

# Retrieve with the rewritten query alone, instead of the original plus the
# rewrite. Off by default: an experiment comparing the two for cmd/eval.
EVAL_REWRITE_ONLY=false

# Question for cmd/rag. Unset by default: pass it as an argument or type it at
# the prompt instead.
# QUESTION=
