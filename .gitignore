# Rust build artifacts (Cargo.lock is committed for the binaries).
# Unanchored so nested acceptance-crate target directories are ignored too.
target/

# Local environment overrides (configuration is read from env vars)
.env
.env.*
!.env.example
*.Local.*

# Editor and OS files
.DS_Store
*.swp
.idea/
.vscode/

# Over-engineering audit report, written by .agents/scripts/audit-agent.sh
AUDIT.md*

/docs/tran/

# Private owner media written by the API (never commit real family files).
/data/

# Local API process state (pid and log files) written by scripts/local-app.sh.
/.run/

# Local agent skill installs (editor tooling, not part of the application).
# Keeping them out of the ignored set made every SOP diff carry ~2.4 MB of
# vendored skill assets, which overflowed the model context in AP-101.
/.agents/
/skills-lock.json
